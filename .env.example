# Copiez ce fichier en `.env` (voir docs/00-installation.md). Il n'y a RIEN à compléter.
#
# Ce TP n'utilise AUCUNE base de données : les tests tournent sur une fausse base
# en mémoire. Les valeurs ci-dessous sont factices et ne servent qu'à démarrer le
# serveur pour afficher Swagger.
DATABASE_URL="postgresql://tp:tp@localhost:5432/tp"
JWT_SECRET="secret-factice-pour-le-tp"
JWT_REFRESH_SECRET="autre-secret-factice-pour-le-tp"

FRONTEND_ORIGIN="http://localhost:3001"
PORT=3000
# Swagger : http://localhost:3000/api/docs
SWAGGER_ENABLED=true
